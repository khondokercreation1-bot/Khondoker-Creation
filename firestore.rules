rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Inquiries Collection: Allow creation of client inquiries
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0;
      allow read: if true;
    }

    // Chats Collection: Allow reading and writing chat messages
    match /chats/{chatId} {
      allow create: if request.resource.data.text is string 
                    && request.resource.data.text.size() > 0 
                    && request.resource.data.sender in ['user', 'assistant'];
      allow read, list: if true;
    }

    // Portfolio Settings & Items: Allow read and write for dynamic showcase updating
    match /portfolio_settings/{settingId} {
      allow read, write: if true;
    }

    match /portfolio_items/{itemId} {
      allow read, write: if true;
    }

    // System connection test
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
